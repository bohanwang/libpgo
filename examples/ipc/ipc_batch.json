{
  "build_dir": "build/base_no_mkl",
  "defaults": {
    "anim_config": "anim.json",
    "log": true
  },
  "cases": {
    "shell": {
      "sim_config": "examples/ipc/shell/shell-ipc.json"
    },
    "tet_box_hang": {
      "sim_config": "examples/ipc/tet/box-hang/box-ipc.json"
    },
    "tet_box_squash": {
      "sim_config": "examples/ipc/tet/box-squash/box-ipc.json"
    },
    "cubic_box_hang": {
      "sim_config": "examples/ipc/cubic/box-hang/box-ipc.json"
    },
    "cubic_box_squash": {
      "sim_config": "examples/ipc/cubic/box-squash/box-ipc.json"
    },
    "cubic_box_with_sphere_lite": {
      "sim_config": "examples/ipc/cubic/box-with-sphere-lite/box-ipc.json"
    },
    "tet_box_drop": {
      "sim_config": "examples/ipc/tet/box/box-ipc.json"
    },
    "cubic_box_drop": {
      "sim_config": "examples/ipc/cubic/box/box-ipc.json"
    },
    "tet_bunny_lite_drop": {
      "sim_config": "examples/ipc/tet/bunny-lite/bunny-ipc.json"
    },
    "tet_dragon_dyn_lite_drop": {
      "sim_config": "examples/ipc/tet/dragon-dyn-lite/dragon-ipc.json"
    },
    "tet_box_with_sphere_lite": {
      "sim_config": "examples/ipc/tet/box-with-sphere-lite/box-ipc.json"
    },
    "cubic_bunny_lite_drop": {
      "sim_config": "examples/ipc/cubic/bunny-lite/bunny-ipc.json"
    },
    "cubic_dragon_dyn_lite_drop": {
      "sim_config": "examples/ipc/cubic/dragon-dyn-lite/dragon-ipc.json"
    }
  },
  "jobs": [
    {
      "name": "shell",
      "cases": ["shell"]
    },
    {
      "name": "hanging_boxes",
      "cases": ["tet_box_hang", "cubic_box_hang"]
    },
    {
      "name": "squash_regression",
      "cases": ["tet_box_squash", "cubic_box_squash"]
    },
    {
      "name": "cubic_cases",
      "cases": ["cubic_box_hang", "cubic_box_squash", "cubic_box_with_sphere_lite", "tet_box_with_sphere_lite"]
    },
    {
      "name": "drop",
      "cases": ["tet_box_drop", "cubic_box_drop", "tet_bunny_lite_drop", "tet_dragon_dyn_lite_drop", "cubic_bunny_lite_drop", "cubic_dragon_dyn_lite_drop"]
    },
    {
      "name": "volume_cases",
      "cases": [
        "tet_box_hang",
        "tet_box_squash",
        "tet_box_drop",
        "cubic_box_hang",
        "cubic_box_squash",
        "cubic_box_with_sphere_lite",
        "cubic_box_drop",
        "tet_bunny_lite_drop",
        "tet_dragon_dyn_lite_drop",
        "tet_box_with_sphere_lite",
        "cubic_bunny_lite_drop",
        "cubic_dragon_dyn_lite_drop"
      ]
    },
    {
      "name": "all_ipc",
      "cases": "all"
    },
    {
      "name": "all_ipc_abc",
      "stages": ["abc"],
      "cases": "all"
    }
  ]
}

{
  "build_dir": "build/base_no_mkl",
  "defaults": {
    "anim_config": "anim.json",
    "log": true
  },
  "cases": {
    "shell": {
      "sim_config": "examples/ipc/shell/shell-ipc.json"
    },
    "tet_box_hang": {
      "sim_config": "examples/ipc/tet/box-hang/box-ipc.json"
    },
    "tet_box_squash": {
      "sim_config": "examples/ipc/tet/box-squash/box-ipc.json"
    },
    "cubic_box_hang": {
      "sim_config": "examples/ipc/cubic/box-hang/box-ipc.json"
    },
    "cubic_box_squash": {
      "sim_config": "examples/ipc/cubic/box-squash/box-ipc.json"
    },
    "cubic_box_with_sphere": {
      "sim_config": "examples/ipc/cubic/box-with-sphere/box-ipc.json"
    },
    "tet_box_drop": {
      "sim_config": "examples/ipc/tet/box/box-ipc.json"
    },
    "cubic_box_drop": {
      "sim_config": "examples/ipc/cubic/box/box-ipc.json"
    }
  },
  "jobs": [
    {
      "name": "shell",
      "cases": ["shell"]
    },
    {
      "name": "hanging_boxes",
      "cases": ["tet_box_hang", "cubic_box_hang"]
    },
    {
      "name": "squash_regression",
      "cases": ["tet_box_squash", "cubic_box_squash"]
    },
    {
      "name": "cubic_cases",
      "cases": ["cubic_box_hang", "cubic_box_squash", "cubic_box_with_sphere"]
    },
    {
      "name": "drop",
      "cases": ["tet_box_drop", "cubic_box_drop"]
    },
    {
      "name": "volume_cases",
      "cases": [
        "tet_box_hang",
        "tet_box_squash",
        "tet_box_drop",
        "cubic_box_hang",
        "cubic_box_squash",
        "cubic_box_with_sphere",
        "cubic_box_drop"
      ]
    },
    {
      "name": "all_ipc",
      "cases": "all"
    },
    {
      "name": "all_ipc_abc",
      "stages": ["abc"],
      "cases": "all"
    }
  ]
}
